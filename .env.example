# Supabase — valeurs reelles a placer dans .env.local, jamais ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle privilegiee : serveur uniquement, ne jamais prefixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Origine publique utilisee pour les liens de confirmation d'e-mail.
# Optionnelle en local : deduite des en-tetes de la requete si absente.
NEXT_PUBLIC_SITE_URL=

# Instagram — configuration « Instagram API with Instagram Login ».
# ATTENTION : ce sont l'Instagram App ID et l'Instagram App Secret (onglet
# Instagram du tableau de bord Meta), PAS l'App ID / App Secret Facebook.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Facebook (Pages) — App ID et App Secret de l'application Meta (produit
# Facebook Login). Distincts des identifiants Instagram ci-dessus.
META_CLIENT_ID=
META_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Price IDs Stripe (mode Test puis Live). Le plan Free n'a pas de Price.
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=

# ---------------------------------------------------------------------------
# Courriel transactionnel — Scaleway TEM (docs/EMAIL.md)
# ---------------------------------------------------------------------------
# Tant que ces variables sont vides, POSTYNC n'envoie AUCUN courriel et se
# rabat sur le lien d'invitation a copier. Ce n'est pas une panne : c'est
# l'etat normal tant que le domaine d'envoi n'est pas authentifie.

# Cle API Scaleway (partie SECRETE). Serveur uniquement — ne jamais prefixer
# par NEXT_PUBLIC_, ne jamais committer. A creer dans la console Scaleway :
# Identifiants et acces > Cles API. La valeur secrete n'est affichee QU'UNE
# FOIS a la creation.
SCW_SECRET_KEY=

# Identifiant du projet Scaleway qui porte le domaine d'envoi.
SCW_PROJECT_ID=

# Region TEM. `fr-par` est le seul choix, et c'est la raison du choix de
# Scaleway : aucune donnee ne quitte l'UE.
SCW_TEM_REGION=fr-par

# Adresse d'expedition. DOIT appartenir a un domaine authentifie chez Scaleway
# (SPF + DKIM poses), sinon les envois sont refuses.
EMAIL_FROM_ADDRESS=

# Nom affiche comme expediteur. Par defaut : le nom du produit.
EMAIL_FROM_NAME=

# Adresse ou doivent arriver les reponses humaines. Facultative : sans elle,
# une reponse part vers l'adresse d'expedition.
EMAIL_REPLY_TO=
